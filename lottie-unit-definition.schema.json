{
  "$id": "lottie-unit-definition@0.1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Verona Player Lottie Unit Definition",
  "type": "object",
  "required": [
    "backgroundColor",
    "scenes",
    "animations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the unit definition"
    },
    "version": {
      "type": "string",
      "description": "Version of the unit definition format"
    },
    "backgroundColor": {
      "type": "string",
      "pattern": "^#([A-Fa-f0-9]{3}){1,2}$",
      "description": "Background color of the unit in hex format"
    },
    "scenes": {
      "type": "array",
      "description": "Array of scenes with different background and layout settings",
      "items": {
        "$ref": "#/definitions/SceneData"
      }
    },
    "animations": {
      "type": "array",
      "description": "List of all animations used",
      "items": {
        "$ref": "#/definitions/AnimationData"
      }
    }
  },
  "definitions": {
    "SceneData": {
      "type": "object",
      "required": [
        "scene",
        "script"
      ],
      "properties": {
        "scene": {
          "type": "string"
        },
        "cockpitSrc": {
          "type": "string",
          "description": "Image File (best svg or transparent png) to use on top of the animations",
          "contentEncoding": "base64"
        },
        "backgroundIds": {
          "type": "array",
          "description": "Array of animations as Ids in the background for the complete scene",
          "items": {
            "type": "string"
          }
        },
        "foregroundIds": {
          "type": "array",
          "description": "Array of animations as Ids in the foreground for the complete scene",
          "items": {
            "type": "string"
          }
        },
        "script": {
          "type": "array",
          "description": "Array of animations and audio to run after each other",
          "items": {
            "$ref": "#/definitions/ScriptData"
          }
        },
        "interaction": {
          "type": "boolean",
          "default": false
        },
        "interactionType": {
          "type": "string"
        },
        "interactionParameters": {
          "$ref": "#/definitions/InteractionParameters"
        }
      }
    },
    "ScriptData": {
      "type": "object",
      "required": [
        "scene",
        "loop",
        "animationIds"
      ],
      "properties": {
        "scene": {
          "type": "string"
        },
        "loop": {
          "type": "boolean",
          "description": "Boolean if the animation should run in a loop"
        },
        "loopCount": {
          "type": "integer",
          "description": "Number of loops to be played (zero for unlimited)",
          "default": 0
        },
        "animationIds": {
          "type": "array",
          "description": "Array of animations as Ids, descending order (z-index) from first animation in array on top",
          "items": {
            "type": "string"
          }
        },
        "audioSrc": {
          "type": "string",
          "description": "Audio to be played along the animations",
          "contentEncoding": "base64"
        },
        "waitForAudioToFinish": {
          "type": "boolean",
          "description": "Wait for the audio to finish to proceed to next animation/scene",
          "default": false
        }
      }
    },
    "AnimationData": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Id of animation used as identifier"
        },
        "animationSrc": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "animations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AnimationData"
          }
        },
        "parameterId": {
          "type": "string",
          "description": "Id of the shared Parameter to choose wich animation has to be used"
        }
      }
    },
    "InteractionParameters": {
      "type": "object",
      "required": [
        "sharedId",
        "options"
      ],
      "properties": {
        "sharedId": {
          "type": "string",
          "description": "Id of the shared Parameter answer will be stored"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/InteractionOptions"
          }
        }
      }
    },
    "InteractionOptions": {
      "type": "object",
      "required": [
        "value"
      ],
      "properties": {
        "imageSrc": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    }
  }
}
